PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.xxxx.mongodb.net/machobeast?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth — https://developers.facebook.com → My Apps
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
